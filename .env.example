# scenenode — copy to `.env.local` and fill in values
# Never commit `.env.local`. Never use NEXT_PUBLIC_* for secrets.

# Required for live video analysis
GEMINI_API_KEY=

# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# Set to "1" to force mock breakdowns even with a key present
FORCE_MOCK_ANALYSIS=0

# Admin panel (logo 7x → /admin)
# Use a long random password (32+ chars). Do NOT use dictionary words.
ADMIN_PASSWORD=
# Separate HMAC signing secret for admin cookies (recommended; defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# Separate HMAC secret for paid-download cookies (recommended; defaults to ADMIN_SECRET/PASSWORD)
SCRIPTS_DOWNLOAD_SECRET=

# Razorpay
# ₹249 = inspect / deconstruct unlock
# ₹499 = After Effects script bundle (reseller commission ₹300)
# Put LIVE keys only in Vercel Project Settings → Environment Variables
# and in local .env.local — NEVER commit real keys to git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Payment SMS / gateway webhook
# Used by:
#   POST /api/webhook?secret=...          (SMS forwarder)
#   POST /api/scripts/payment/webhook     (header: x-payment-webhook-secret)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_WEBHOOK_SECRET=

# UPI payee (server-only — never NEXT_PUBLIC_*) — optional fallback
UPI_PAYEE_ID=
UPI_PAYEE_NAME=scenenode

# Master Command Center (/command) telemetry bus
# Other apps POST JSON to /api/telemetry with header: x-ops-secret
# SceneNode also forwards here when MASTER_OPS_WEBHOOK_URL is an *external* sink.
# Pointing this at this same app's /api/telemetry is a no-op (self-forward skipped).
MASTER_OPS_WEBHOOK_URL=
MASTER_OPS_WEBHOOK_SECRET=

# Autonomous marketing worker (workers/autonomous_marketing.py)
# Creator-owned branded renders only — never strip third-party watermarks.
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_IDS=
SCENENODE_VIDEO_URLS=
SCENENODE_VIDEO_THEME=dark mood aesthetic celeb transition
# Set to 1 on the cron host to actually schedule via Buffer
SCENENODE_PUBLISH=0
SCENENODE_OPS_WEBHOOK=
SCENENODE_OPS_SECRET=
